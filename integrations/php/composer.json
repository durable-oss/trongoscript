{
    "name": "durable-oss/trongoscript-php",
    "description": "PHP extension for Trongoscript, a small Lisp for building configuration data",
    "type": "project",
    "license": ["MIT", "Apache-2.0"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Trongoscript\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": "cargo build",
        "test": [
            "@build",
            "@php -d extension=target/debug/libtrongoscript.so vendor/bin/phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
